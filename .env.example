BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_IDS=
CENTER_ADMIN_TG_ID=8067625824

# Standart parametrlar
CAPACITY=9
GROUP_WINDOW_MIN=20
MIN_GAP_BETWEEN_TRIPS_MIN=40
PICKUP_LEAD_MIN=30
STOP_DWELL_MIN=2
MAX_WAIT_MIN=30

DAILY_PLAN_TIME=06:30
AUTO_APPROVE_TIME=07:00
TIMEZONE=Asia/Tashkent

# Railway'da avval service'ga /app/data mount yo'li bilan Volume ulang.
# Railway RAILWAY_VOLUME_MOUNT_PATH ni o'zi beradi; DB_PATH shu Volume ichida bo'lishi shart.
DB_PATH=/app/data/damas_reys.db
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_CHAT_ID=

# Railway public HTTPS address for the Telegram Mini App.
# Example: https://your-service.up.railway.app
MINIAPP_URL=
